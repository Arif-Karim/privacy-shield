{
  "manifest_version": 3,
  "name": "Privacy Shield",
  "version": "0.4.0",
  "description": "Warns you before you give your phone number to a site that may sell it or pass it to companies that will call you.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://privacy-shield-api.arifjubairulkarim.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Privacy Shield"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
